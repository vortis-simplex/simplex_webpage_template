---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getUpdates, isoDate, updateSlug, type Update } from "../../lib/updates";

export async function getStaticPaths() {
  const updates = await getUpdates();
  return updates
    .filter((u) => !u.data.link)
    .map((u) => ({ params: { slug: updateSlug(u) }, props: { entry: u } }));
}

const { entry } = Astro.props as { entry: Update };
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="container article">
    <header class="article-header">
      <p class="label"><a href="/updates/">Updates</a></p>
      <h1 class="display sm">{entry.data.title}</h1>
      <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
