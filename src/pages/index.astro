---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import site from "../config/site.json";
import { formatDate, getUpdates, isoDate, updateHref } from "../lib/updates";

const home = await getEntry("home", "home");
if (!home) throw new Error("Missing src/content/home.md");
const { data } = home;
const { Content } = await render(home);
const updates = (await getUpdates()).slice(0, 3);
---

<Base fullTitle title={site.title} description={site.description}>
  <section class="hero container">
    <h1 class="display">
      {data.headline}
      {data.headline_em && <em>{data.headline_em}</em>}
    </h1>
    {data.lede && <p class="lede">{data.lede}</p>}
    {
      data.cta && (
        <a class="cta" href={data.cta.href}>
          {data.cta.label} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </section>

  <section class="section">
    <div class="container grid">
      <h2 class="label num">What we build</h2>
      <div class="statement"><Content /></div>
    </div>
  </section>

  {
    data.pillars.length > 0 && (
      <section class="section">
        <div class="container grid">
          <h2 class="label num">{data.pillars_label}</h2>
          <ul class="pillars">
            {data.pillars.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    data.image && (
      <section class="section">
        <figure class="container figure">
          <Image
            src={data.image.src}
            alt={data.image.alt}
            widths={[720, 1152, 1600, 1920]}
            sizes="(min-width: 78rem) 72rem, 92vw"
            loading="lazy"
            decoding="async"
          />
          {data.image.caption && <figcaption class="caption">{data.image.caption}</figcaption>}
        </figure>
      </section>
    )
  }

  {
    updates.length > 0 && (
      <section class="section">
        <div class="container grid">
          <h2 class="label num">Updates</h2>
          <div>
            <ul class="updates">
              {updates.map((u) => (
                <li>
                  <time datetime={isoDate(u.data.date)}>{formatDate(u.data.date)}</time>
                  <a href={updateHref(u)}>{u.data.title}</a>
                </li>
              ))}
            </ul>
            <a class="more" href="/updates/">
              All updates <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    data.contact && (
      <section class="section" id="contact">
        <div class="container grid">
          <h2 class="label num">Contact</h2>
          <div>
            <h3 class="title">{data.contact.heading}</h3>
            {data.contact.text && <p class="lede">{data.contact.text}</p>}
            <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>
      </section>
    )
  }
</Base>
